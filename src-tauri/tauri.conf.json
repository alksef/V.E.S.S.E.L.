{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VESSEL",
  "identifier": "dev.vessel.overlay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VESSEL",
        "url": "index.html",
        "width": 500,
        "height": 700,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/icon.ico"
    ]
  }
}
