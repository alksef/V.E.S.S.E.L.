{
  "name": "vessel",
  "description": "VESSEL - Virtual Entity Surface for Synthetic Existence & Life",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "build:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Mode release",
    "build:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Mode debug",
    "send": "node scripts/send.mjs",
    "check:mcp": "node scripts/check-mcp.mjs",
    "test:e2e": "node scripts/e2e-runner.mjs",
    "dev:app": "tauri dev",
    "start:headless": "cargo run --manifest-path src-tauri/Cargo.toml -- --headless"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
